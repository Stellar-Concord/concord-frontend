# Soroban RPC endpoint used to build/simulate/submit contract transactions.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Must match the network the RPC endpoint above serves.
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The deployed concord-escrow contract's address (starts with "C").
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# The concord-backend REST API base URL (see ../concord-backend).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
